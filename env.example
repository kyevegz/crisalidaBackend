# Copia este archivo como ".env" y llena los valores con TUS datos de Neon.
# El archivo ".env" NO se sube a GitHub (agrégalo al .gitignore).

# --- Base de datos (Neon > Connect: copia host, usuario, contraseña y nombre) ---
DB_HOST=ep-xxxxxxxx-pooler.c-14.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=crisalida

# --- Secretos de la app: genera cada uno con el comando indicado ---
# python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
CLAVE_AES=

# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# python -c "import secrets;print(secrets.token_urlsafe(32))"
PIN_PEPPER=

# Duración de la sesión en horas (opcional, por defecto 24)
JWT_HORAS=24

# --- IA del Radar de talentos (https://aistudio.google.com → "Get API key") ---
GEMINI_API_KEY=
# Pon el nombre EXACTO de un modelo Flash o Flash-Lite que AI Studio te marque como gratuito
GEMINI_MODEL=gemini-flash-latest

# --- Marketplace / demo (opcionales) ---
# true = las publicaciones nuevas se aprueban solas (útil para la demo). Por defecto quedan "en_revision".
AUTOAPROBAR_PUBLICACIONES=false
# true = activa /demo/... (simular ventas y validación de retos). Apágalo en producción.
MODO_DEMO=false
